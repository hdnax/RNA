{
  "$schema": "https://json.schemastore.org/package",
  "name": "rna",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish && git push --follow-tags",
    "doc:build": "node scripts/build-docs.mjs"
  },
  "keywords": [
    "design system",
    "vue",
    "eslint",
    "storybook"
  ],
  "author": "H-DNA",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "@vitest/browser": "^4.1.11",
      "minimatch@>=10.0.0": "^10.2.6",
      "minimatch@<3.1.3": "^3.1.5",
      "lodash@>=4.0.0": "^4.18.1",
      "esbuild@>=0.17.0": "^0.28.2",
      "ajv@>=7.0.0": "^8.20.0",
      "form-data@4.0.5": "^4.0.6",
      "js-yaml@>=3.0.0": "^3.15.2",
      "js-yaml@>=4.0.0": "^4.3.2",
      "brace-expansion@<1.1.13": "^1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=5.0.0 <5.0.6": "^5.0.9",
      "immutable@>=5.0.0 <5.1.8": "^5.1.9"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@hdnax/nuclint": "workspace:*",
    "eslint": "^10.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
