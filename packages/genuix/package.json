{
  "$schema": "https://json.schemastore.org/package",
  "name": "@hdnax/genuix",
  "version": "0.18.0",
  "description": "A personal design system - Gene + UI/UX = Genuix.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hdnax/rna.git",
    "directory": "packages/genuix"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/genuix.js",
      "require": "./dist/genuix.umd.cjs"
    },
    "./style.css": "./dist/genuix.css"
  },
  "main": "./dist/genuix.umd.cjs",
  "module": "./dist/genuix.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "design system",
    "vue",
    "storybook"
  ],
  "scripts": {
    "dev": "storybook dev -p 8686",
    "build": "vite build",
    "build-storybook": "storybook build",
    "doc:build": "storybook build -o doc-dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hdnax/stdx": "workspace:*",
    "dompurify": "^3.4.13",
    "floating-vue": "^5.2.2",
    "katex": "^0.16.45",
    "luxon": "^3.7.2"
  },
  "peerDependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "highlight.js": "^11.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@hdnax/nuclint": "workspace:*",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/addon-vitest": "10.3.6",
    "@storybook/vue3-vite": "10.3.6",
    "@tailwindcss/vite": "^4.2.4",
    "@types/luxon": "^3.7.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/browser-playwright": "^4.1.5",
    "highlight.js": "^11.11.1",
    "pinia": "^3.0.4",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "storybook": "10.3.6",
    "storybook-addon-vue-slots": "^0.9.29",
    "storybook-design-token": "^5.0.0",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.5"
  }
}
